# Production requires HTTPS, Google credentials, explicit household emails.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
APP_DATABASE=./data/app.sqlite
# Directory written by .agents/tools/backup-app.mjs. Readiness warns when its newest
# backup is older than 36 hours. Leave unset when backups are not configured.
APP_BACKUP_DIR=
# fatal, error, warn, info, debug, trace or silent. Defaults to info.
LOG_LEVEL=
GOOGLE_CLIENT_ID=
HOUSEHOLD_EMAILS=
# Explicit opt-in; only permitted in development bound to a loopback address.
LOCAL_DEV_AUTH=false
# Native harness workspace directory. Defaults to harness beside APP_DATABASE.
WILDBOTS_WORKSPACE_ROOT=
# Optional 32-byte key (base64 or hex) encrypting bot vault secrets at rest.
WILDBOTS_VAULT_KEY=
# Optional real host terminal. Installer-managed, owner-private absolute paths.
COMPUTER_TERMINAL_ENABLED=false
COMPUTER_STATE_DIR=
COMPUTER_TERMINAL_CWD=
COMPUTER_PYTHON=
# Household members who can open the system terminal. Everyone keeps the shared
# desktop. When omitted, uses INTEGRATION_ADMINS. Set an empty value to turn
# the shell off. Local test accounts are one@localhost.invalid and two@localhost.invalid.
COMPUTER_TERMINAL_ADMINS=
# Household members who can connect, reconnect, or remove integrations.
# Set an empty value for read-only integrations. Local development accounts can manage fixtures.
INTEGRATION_ADMINS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional native iOS notifications. Supply every APNs setting together.
# Use the signing team's ID, Apple key ID, and the iOS app's actual bundle ID.
# Keep the downloaded .p8 key outside the repository, readable only by the server.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY_FILE=
# sandbox for development builds; production for TestFlight/App Store builds.
APNS_ENVIRONMENT=
# Optional LAN and tailnet routes the iOS app prefers when it can reach them:
# lan, tailnet or lan,tailnet. A cloud server lists only tailnet. Open DIRECT_PORT
# in the host firewall on those interfaces. The certificate lives in DIRECT_TLS_DIR,
# by default direct-tls beside the database.
DIRECT_ROUTES=
DIRECT_PORT=
DIRECT_TLS_DIR=
# Optional iOS update banner. Set both after distributing a build: its whole-number
# CFBundleVersion and the HTTPS link that installs it, such as a TestFlight invitation.
IOS_APP_LATEST_BUILD=
IOS_APP_UPDATE_URL=
