# Production requires HTTPS, Google credentials, explicit household emails.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
APP_DATABASE=./data/app.sqlite
GOOGLE_CLIENT_ID=
HOUSEHOLD_EMAILS=
# Explicit opt-in; only permitted in development bound to a loopback address.
LOCAL_DEV_AUTH=false
# Hermes integration configuration. Leave unset to display disconnected state.
HERMES_URL=
HERMES_TOKEN=
# service uses a private add-on key and one-time WS tickets with the existing Google dashboard.
# static is retained for isolated loopback fixtures using the native process session token.
HERMES_AUTH_MODE=static
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional native iOS notifications. Supply every APNs setting together.
# Use the signing team's ID, Apple key ID, and the iOS app's actual bundle ID.
# Keep the downloaded .p8 key outside the repository, readable only by the server.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY_FILE=
# sandbox for development builds; production for TestFlight/App Store builds.
APNS_ENVIRONMENT=
