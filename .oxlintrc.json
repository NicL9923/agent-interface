{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "ios/**",
    "public/**",
    "build/**"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-unused-expressions": [
      "warn",
      {
        "allowTernary": true,
        "allowShortCircuit": true
      }
    ],
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off"
  },
  "overrides": [
    {
      "files": [
        ".agents/tools/*.js"
      ],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
