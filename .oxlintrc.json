{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["dist/**", "ios/**", "public/**", "build/**"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-unused-expressions": [
      "warn",
      {
        "allowTernary": true,
        "allowShortCircuit": true
      }
    ],
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "typescript/no-floating-promises": "warn",
    "typescript/no-misused-promises": "warn"
  },
  "overrides": [
    {
      "files": ["e2e/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "importNames": ["test"],
                "message": "Import test from ./fixtures.js: its fixtures refuse routes the service worker would hide in WebKit and check every page for errors."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [".agents/tools/*.js"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
