{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "typescript", "react"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["dist/**", "ios/**", "public/**", "build/**"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-unused-expressions": [
      "warn",
      {
        "allowTernary": true,
        "allowShortCircuit": true
      }
    ],
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    "react/no-array-index-key": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-object-type-as-default-prop": "error",
    "react/set-state-in-render": "error",
    "react/use-memo": "error",
    "react/error-boundaries": "error",
    "react/static-components": "error",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/purity": "off"
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "react/jsx-no-constructed-context-values": "off",
        "react/no-array-index-key": "off",
        "react/globals": "off",
        "react/no-children-prop": "off"
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "allowTypeImports": true,
                "message": "Import test and expect from ./fixtures.js: its fixtures refuse routes the service worker would hide in WebKit and check every page for errors. Type-only imports are fine."
              },
              {
                "name": "playwright/test",
                "allowTypeImports": true,
                "message": "Import test and expect from ./fixtures.js: its fixtures refuse routes the service worker would hide in WebKit and check every page for errors. Type-only imports are fine."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [".agents/tools/*.js"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
