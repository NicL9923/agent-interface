{
  "name": "agent-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^24.22.2 || ^26.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:bun": "bun run --no-env-file --no-install --watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsrs --noEmit && vite build && node scripts/build-worker.mjs",
    "build:server:bun": "node scripts/build-server.mjs",
    "start": "tsx src/server/index.ts",
    "start:bun": "bun run --no-env-file --no-install src/server/index.ts",
    "smoke:bun": "bun run --no-env-file --no-install scripts/bun-smoke.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --deny-warnings src scripts tests e2e .agents/tools",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:py": "python3 scripts/run-python-tests.py",
    "lint:py": "ruff check .",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/setup.ts --check",
    "prepare": "node scripts/install-hooks.mjs",
    "verify:ci": "node scripts/check-parallel.mjs",
    "format": "python3 .agents/tools/format-python.py --write && oxfmt --write --no-error-on-unmatched-pattern \"**/*.{ts,tsx,js,jsx,mjs}\" && prettier --write --log-level warn \"**/*.{css,json,md,yml,yaml}\"",
    "format:check": "python3 .agents/tools/format-python.py --check && oxfmt --check --no-error-on-unmatched-pattern \"**/*.{ts,tsx,js,jsx,mjs}\" && prettier --check \"**/*.{css,json,md,yml,yaml}\""
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "effect": "4.1.4",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.4",
    "highlight.js": "11.12.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "4.0.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.94.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "oxlint --deny-warnings",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.py": [
      "python3 .agents/tools/staged-python.py"
    ]
  }
}
