{
  "name": "agent-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsrs --noEmit && vite build && node scripts/build-worker.mjs",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --deny-warnings src scripts tests e2e .agents/tools",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:py": "python3 scripts/run-python-tests.py",
    "lint:py": "ruff check .",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/setup.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.6",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "effect": "4.1.2",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.3",
    "highlight.js": "11.12.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "4.0.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "oxlint": "1.91.0",
    "tailwindcss": "4.3.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
