{
  "name": "agent-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.21.0 || ^26.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsrs --noEmit && vite build && node scripts/build-worker.mjs",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "test:py": "python3 scripts/run-python-tests.py",
    "lint:py": "ruff check .",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/setup.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "fastify": "5.12.5",
    "google-auth-library": "11.2.0",
    "highlight.js": "11.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
